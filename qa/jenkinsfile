pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'maven'
    }

    parameters {
        choice(
            name: 'BRANCH',
            choices: ['main', 'dev'],
            description: 'Select branch to build'
        )

        booleanParam(
            name: 'DEPLOY_TO_TOMCAT',
            defaultValue: true,
            description: 'Deploy application to Tomcat?'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: "${params.BRANCH}",
                    credentialsId: 'git-token',
                    url: 'https://github.com/udevop-2026/demo-spring-framework-petclinic.git'
            }

        }

        stage('Build and SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh '''
                        mvn clean package \
                        org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                        -Dsonar.projectKey=petclinic-demo-project
                    '''
                }
            }
        }

## It means the Deploy to Tomcat stage will execute only when the user selects the DEPLOY_TO_TOMCAT checkbox while starting the build.
## "Jenkins lo when condition ni particular stage execute cheyyala vadha ani control cheyyadaniki use chestham.

        stage('Deploy to Tomcat') {  
            when {
                expression {
                    return params.DEPLOY_TO_TOMCAT
                }
            }

            steps {
                sshagent(credentials: ['tomcat-key']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no root@172.31.25.174 \
                        "rm -rf /opt/apache-tomcat-11.0.27/webapps/petclinic \
                         /opt/apache-tomcat-11.0.27/webapps/petclinic.war"

                        scp -o StrictHostKeyChecking=no target/*.war \
                        root@172.31.25.174:/opt/apache-tomcat-11.0.27/webapps/petclinic.war
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'PetClinic pipeline completed successfully'
        }

        failure {
            echo 'PetClinic pipeline failed'
        }
    }
}
